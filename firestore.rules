rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation for User Profiles
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 120
        && (!('isJehovahsWitness' in data) || data.isJehovahsWitness is bool)
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Validation for Speech Outlines
    function isValidSpeech(data) {
      return data.keys().hasAll(['userId', 'title'])
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('category' in data) || (data.category is string && data.category.size() <= 60))
        && (!('targetMinutes' in data) || (data.targetMinutes is number && data.targetMinutes >= 0 && data.targetMinutes <= 300))
        && (!('speechNotes' in data) || (data.speechNotes is string && data.speechNotes.size() <= 50000))
        && (!('sections' in data) || (data.sections is list && data.sections.size() <= 50))
        && (!('sourceFileName' in data) || (data.sourceFileName is string && data.sourceFileName.size() <= 255))
        && (!('sourceFileType' in data) || (data.sourceFileType is string && data.sourceFileType.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Validation for Rehearsal Logs
    function isValidRehearsal(data) {
      return data.keys().hasAll(['userId', 'durationSeconds'])
        && data.userId is string && data.userId == request.auth.uid
        && data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400
        && (!('speechId' in data) || (data.speechId is string && data.speechId.size() <= 128))
        && (!('speechTitle' in data) || (data.speechTitle is string && data.speechTitle.size() <= 200))
        && (!('targetSeconds' in data) || (data.targetSeconds is number && data.targetSeconds >= 0 && data.targetSeconds <= 86400))
        && (!('evaluation' in data) || (data.evaluation is string && data.evaluation.size() <= 20000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Speeches & Outlines collection
    match /speeches/{speechId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidSpeech(request.resource.data);
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid 
        && isValidSpeech(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Rehearsal logs collection
    match /rehearsals/{rehearsalId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidRehearsal(request.resource.data);
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid 
        && isValidRehearsal(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
